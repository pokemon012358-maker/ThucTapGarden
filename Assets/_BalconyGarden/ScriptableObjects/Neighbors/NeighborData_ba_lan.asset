  neighborId: ba_lan
  neighborName: "B\xE0 Lan"
  avatarSprite: {fileID: 21300000, guid: b143a200c5b746040afe4edcb8c1173d, type: 3}
  bio: "B\xE0 h\xE0ng x\xF3m t\u1EA7ng d\u01B0\u1EDBi hi\u1EC1n t\u1EEB, hay n\u1EA5u
    canh rau c\u1EA3i v\xE0 ng\u1EAFm hoa c\xFAc."
