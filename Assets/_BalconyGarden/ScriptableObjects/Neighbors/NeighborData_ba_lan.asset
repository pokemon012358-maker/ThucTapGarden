  - cai_xanh
  - cuc_vang
  storyDialogues:
  - requiredFriendship: 0
    dialogueText: "Ch\xE1u tr\u1ED3ng rau m\xE1t tay qu\xE1, nh\xECn m\u01B0\u1EDBt
      c\u1EA3 m\u1EAFt!"
  - requiredFriendship: 30
    dialogueText: "Nh\xECn kh\xF3m c\xFAc v\xE0ng c\u1EE7a ch\xE1u b\xE0 l\u1EA1i
      nh\u1EDB qu\xEA ng\xE0y x\u01B0a..."
  - requiredFriendship: 60
    dialogueText: "M\u1ED7i l\u1EA7n l\xEAn ban c\xF4ng g\u1EB7p ch\xE1u l\xE0 b\xE0
      th\u1EA5y b\xECnh y\xEAn h\u1EB3n."
