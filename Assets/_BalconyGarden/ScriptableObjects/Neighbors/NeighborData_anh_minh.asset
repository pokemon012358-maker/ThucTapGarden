  - cai_xanh
  storyDialogues:
  - requiredFriendship: 0
    dialogueText: "C\u1EA3m \u01A1n nh\xE9! T\u1ED1i nay m\xECnh c\xF3 c\xE0 chua
      l\xE0m m\u1EF3 \xDD r\u1ED3i!"
  - requiredFriendship: 30
    dialogueText: "\u0110\u1ED3 \xE1n th\u1EE9c \u0111\xEAm m\xE0 c\xF3 rau c\u1EE7
      t\u01B0\u01A1i c\u1EE7a b\u1EA1n th\xEC \u0111\u1EC9nh ch\xF3p!"
  - requiredFriendship: 60
    dialogueText: "B\u1EA1n thi\u1EBFt k\u1EBF ban c\xF4ng xanh n\xE0y tr\xF4ng c\xF3
